# ── Base de datos (Neon) ────────────────────────────────────────────────
# En Vercel se rellena sola al conectar la integración de Neon.
# Elegir región europea al crear el proyecto: la ficha lleva DNI y teléfono
# de los propietarios y no debe salir del EEE.
DATABASE_URL=postgresql://usuario:clave@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Ojo con la sintaxis: es CLAVE=valor. Con ":" la variable se ignora en
# silencio y el endpoint responde 500.

# ── PIN de los agentes (app móvil) ──────────────────────────────────────
# Largo y alfanumérico. Un PIN de 4-6 dígitos se rompe por fuerza bruta.
PIN_ACCESO=cambia-esto-por-algo-largo-y-alfanumerico

# ── Acceso al panel /admin: Neon Auth (Google) ──────────────────────────
# Las rellena `npx neon link`; el navegador necesita además la copia VITE_.
NEON_AUTH_BASE_URL=https://xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
VITE_NEON_AUTH_BASE_URL=https://xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth

# Quién puede abrir el panel. SIN ESTO NO ENTRA NADIE (se deniega por defecto).
# Emails sueltos separados por comas, o un dominio entero con @dominio.com
ADMIN_EMAILS=@tuempresa.com

# ── Lista de agentes ────────────────────────────────────────────────────
# Generar con: npm run agentes:env
AGENTES_JSON=[{"id":"a1","name":"Nombre Apellido","role":"Agente Comercial","email":"nombre@tuempresa.com","phone":"600000000"}]
