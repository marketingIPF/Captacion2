{
  "name": "captacion-rk-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "test": "node --test test/*.test.js",
    "agentes:env": "node scripts/print-agentes-env.mjs",
    "dev:mock": "MOCK_API=1 VITE_AUTH_SIMULADA=1 vite",
    "avatares": "node dev/generar-avatares.mjs",
    "db:esquema": "node --env-file=.env dev/aplicar-esquema.mjs db/schema.sql",
    "db:probar": "node --env-file=.env dev/probar-api.mjs",
    "dev:login": "MOCK_API=1 vite",
    "db:prueba": "node --env-file=.env dev/fichas-de-prueba.mjs",
    "db:prueba:borrar": "node --env-file=.env dev/fichas-de-prueba.mjs --borrar",
    "iagestion:previa": "node --env-file=.env dev/iagestion-vista-previa.mjs",
    "iagestion:probar-real": "node dev/iagestion-probar-real.mjs",
    "push:probar": "node --env-file=.env dev/probar-push.mjs",
    "iconos": "node dev/generar-iconos.mjs",
    "dev:muchas": "MOCK_API=1 VITE_AUTH_SIMULADA=1 MOCK_FICHAS=460 vite"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.7.2",
    "jose": "^6.2.10",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
